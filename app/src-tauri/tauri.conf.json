{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HawkSnap",
  "version": "1.2.0",
  "identifier": "com.hawksnap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "huluohu",
    "category": "Utility",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "shortDescription": "Lightweight screenshot, annotation, OCR and screen recording tool",
    "longDescription": "HawkSnap (猎影) is a lightweight screenshot tool: region/window capture, annotation editor, OCR, scrolling capture, screen recording, pins and history — all local, no telemetry.",
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.3"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      }
    },
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/huluohu/HawkSnap/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwQjExODNENTI5QUREOUMKUldTYzNacFNQUml4Y0NDd1JMWFIvRkhnSGhxZ280OXQ2Wlc1MSsvQVZ4b1F5Si83cDh1UlllVlcK"
    }
  }
}
